FROM python:3.12-slim-bookworm AS dependencies

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --no-cache-dir \
    'piper-tts==1.8.0' \
    'onnxruntime==1.30.0' \
    'numpy==2.5.3'

FROM dependencies AS test
WORKDIR /app
COPY apps/tts-service/main.py /app/main.py
COPY apps/tts-service/test_main.py /app/test_main.py
RUN python /app/test_main.py

FROM dependencies AS runtime
RUN groupadd --system --gid 10001 tts \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin tts

WORKDIR /app
COPY --from=test /app/main.py /app/main.py

USER 10001:10001
EXPOSE 3081
ENTRYPOINT ["python", "/app/main.py"]
